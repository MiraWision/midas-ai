# Copy to .env and fill in. NEVER commit .env.

# Postgres (docker-compose up -d db  → this default works out of the box)
DATABASE_URL=postgres://midas:midas@localhost:5432/midas

# --- Market data (public endpoints — no API keys required) ---
KRAKEN_MARKET_DATA_API_BASE=https://api.kraken.com

# --- Live trading (OPT-IN, off by default; see docs/self-hosting.md) ---
# MidasAI ships sandbox-first. Only set these if you have read the safety
# notes and accept the risk. Create keys WITHOUT withdrawal permission.
# KRAKEN_TRADING_API_KEY=
# KRAKEN_TRADING_API_SECRET=
